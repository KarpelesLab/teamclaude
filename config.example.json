{
  "proxy": {
    "port": 3456,
    "apiKey": "tc-change-me-to-a-secret",
    "clientKeys": [
      { "name": "laptop", "key": "tc-laptop-own-secret" },
      { "name": "build-box", "key": "tc-build-box-own-secret" },
      { "name": "sandboxed-agent", "key": "tc-sandboxed-agent-own-secret", "scope": "inference" }
    ],
    "usageDimensions": [
      { "name": "project", "header": "x-teamclaude-project" },
      { "name": "ref", "header": "x-teamclaude-ref" }
    ],
    "sessionDetail": true,
    "dashboardLogin": { "username": "me", "passwordHash": "scrypt$32768$8$1$set-from-the-dashboard$not-by-hand" },
    "logPrompts": false,
    "mcp": "off",
    "drainTimeoutSeconds": 0,
    "controlPlane": "client"
  },
  "upstream": "https://api.anthropic.com",
  "switchThreshold": 0.98,
  "stripOverageHeaders": false,
  "synthesizeQuotaHeaders": false,
  "poolQuotaHeaders": false,
  "distributeSessions": false,
  "compactBeforeSwitch": false,
  "persistSessionAffinity": false,
  "switchOnSessionReset": true,
  "adaptiveDistribution": {
    "scoring": "burndown"
  },
  "advisorEligibility": "strict",
  "quotaProbeSeconds": 0,
  "outsideSpendHidePercent": 5,
  "autoUpdate": true,
  "autoRedeemResets": false,
  "autoRedeemMinDaysToReset": 0,
  "autoRedeemMaxShare": 1,
  "autoRedeemMaxPerDay": 0,
  "expiryRouting": {
    "enabled": false,
    "tolerance": 1.5,
    "preempt": true,
    "reclaimHours": 0,
    "reclaimAcrossOrganizations": false
  },
  "affinity": {
    "nearResetMinutes": 15,
    "weeklyHeadroom": 0.1
  },
  "accounts": [
    {
      "name": "primary-max",
      "type": "oauth",
      "importFrom": "~/.claude/.credentials.json"
    },
    {
      "name": "user@example.com (Acme)",
      "type": "oauth",
      "accountUuid": "optional-account-uuid",
      "orgUuid": "optional-organization-uuid",
      "orgName": "Acme",
      "email": "user@example.com",
      "priority": 0,
      "accessToken": "sk-ant-oat01-your-access-token",
      "refreshToken": "sk-ant-ort01-your-refresh-token"
    },
    {
      "name": "waffles@waffle.com",
      "type": "oauth",
      "accessToken": "sk-ant-oat01-your-access-token",
      "refreshToken": "sk-ant-ort01-your-refresh-token",
      "routing": "socks5h://alice:s3cret@proxy.example.com:1080"
    },
    {
      "name": "codex@example.com",
      "type": "oauth",
      "provider": "codex",
      "priority": 0
    },
    {
      "name": "api-fallback",
      "type": "apikey",
      "priority": 10,
      "disabled": false,
      "cordoned": false,
      "apiKey": "sk-ant-api03-your-api-key"
    },
    {
      "name": "api-credit",
      "type": "apikey",
      "priority": 100,
      "disabled": true,
      "apiKey": "sk-ant-api03-your-credit-org-api-key",
      "credit": {
        "amount": 200,
        "currency": "USD",
        "cycleStart": "2026-11-02",
        "adminKey": "sk-ant-admin01-your-admin-key",
        "refreshMinutes": 15
      }
    }
  ],
  "routes": [
    {
      "name": "fable",
      "match": ["*fable*"],
      "accounts": ["primary-max"],
      "color": "magenta"
    }
  ],
  "upstreamProxy": "http://proxy.corp.example:3128",
  "egress": {
    "pin": "auto",
    "checkUrl": "https://api.ipify.org",
    "ttlSeconds": 30,
    "holdSeconds": 120
  },
  "instanceName": "hermes",
  "instanceAddress": "http://100.64.0.1:3456",
  "peers": [
    {
      "name": "server",
      "url": "http://100.64.0.2:3456",
      "apiKey": "your-server-proxy-key"
    }
  ],
  "accountSync": {
    "mode": "cluster",
    "members": ["server", "hermes"]
  }
}
